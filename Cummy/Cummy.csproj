<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.7.1.1</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Rayla Petal</Author>
    <Name>Cummy</Name>
    <Punchline>Cum layering system for your paired partners.</Punchline>
    <Description>Pair with someone over tells, then right-click them to layer cum onto a body part. Layers stack on top of their own current skin (Bibo body), are published through Penumbra so sync plugins show them to everyone, and stay until cleaned or dried off.
Requires Penumbra. 18+ content.</Description>
    <Tags>nsfw;penumbra;overlay;bibo</Tags>
    <IconUrl>https://raw.githubusercontent.com/RaylaPetal/cummy/main/Cummy/images/icon.png</IconUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/build-assets.py from Textures/Finished. -->
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <!-- The creampie drip (Dripping Pussy VFX by Tirda Frye): effects and ring model, see README credits. -->
    <Content Include="Assets\drip\*.avfx;Assets\drip\*.mdl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Packed next to the plugin so the installer shows it for dev builds too; images/icon.svg is the source. -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- The client file other plugins copy (Cummy.Api/CummyIpc.cs). Debug builds compile it and drive the debug panel
         through it, so it is checked against the real gates; Release builds never ship it. -->
    <Compile Include="..\Cummy.Api\CummyIpc.cs" Link="Ipc\CummyIpcClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <!-- Glamourer IPC (optional at runtime): puts the drip ring on and back off. -->
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Built from source against the Penumbra.Api and Luna submodules, as Oathbound does: the published Penumbra.Api
      package references an assembly named "Luna" while the Luna package's DLL is "Luna.Core".
    -->
    <ProjectReference Include="..\Penumbra.Api\Penumbra.Api.csproj" />
    <ProjectReference Include="..\Luna\Luna\Luna.csproj" />
    <ProjectReference Include="..\Luna\Luna.Generators\Luna.Generators.csproj" OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
